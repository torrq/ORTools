<UserControl x:Class="ORTools.UI.Views.UpdateAvailableDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ORTools.UI.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="250" d:DesignWidth="400"
             d:DataContext="{d:DesignInstance vm:UpdateAvailableDialogViewModel}"
             Background="Transparent">

    <Border Background="{DynamicResource AppSurfaceBrush}" 
            BorderBrush="{DynamicResource AppBorderBrush}" 
            BorderThickness="1" 
            CornerRadius="8" 
            Padding="24"
            HorizontalAlignment="Center" 
            VerticalAlignment="Center">

        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="20" Opacity="0.5" Direction="270" ShadowDepth="5"/>
        </Border.Effect>

        <StackPanel MinWidth="280">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,16">
                <TextBlock FontFamily="pack://application:,,,/Fonts/#lucide" Text="&#xE145;" FontSize="20" Foreground="{DynamicResource AppLinkBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <TextBlock Text="{DynamicResource S.Dialog.UpdateAvailableTitle}" Foreground="{DynamicResource AppTextBrush}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>

            <TextBlock Text="{Binding MessageText}" Foreground="{DynamicResource AppTextBrush}" FontSize="14" Margin="0,0,0,24" TextWrapping="Wrap" MaxWidth="360" HorizontalAlignment="Center" TextAlignment="Center"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="{DynamicResource S.Dialog.Close}" Command="{Binding CloseCommand}" 
                        IsCancel="True"
                        Style="{StaticResource SecondaryButtonStyle}" 
                        Width="100" Height="32" Margin="0,0,12,0"
                        Foreground="{DynamicResource AppSubtleBrush}"
                        Background="Transparent"/>

                <Button Content="{DynamicResource S.Dialog.DownloadUpdate}" Command="{Binding OpenDirectZipUrlCommand}" 
                        ToolTip="{Binding DirectZipUrl}"
                        IsDefault="True"
                        Style="{StaticResource PrimaryButtonStyle}" 
                        Padding="12,0" Height="32"/>
            </StackPanel>

            <Button Command="{Binding DisableAutoCheckingCommand}" 
                    Style="{StaticResource SecondaryButtonStyle}" 
                    FontSize="11" Padding="8,4" Margin="0,16,0,0"
                    HorizontalAlignment="Center"
                    Background="Transparent" BorderThickness="0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock FontFamily="pack://application:,,,/Fonts/#lucide" Text="&#xE05A;" FontSize="13" Foreground="{DynamicResource AppDangerBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{DynamicResource S.Dialog.DisableAutoCheck}" Foreground="{DynamicResource AppSubtleBrush}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </StackPanel>
    </Border>
</UserControl>
