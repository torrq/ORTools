<UserControl x:Class="ORTools.UI.Views.ProfilesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ORTools.UI.ViewModels" xmlns:helpers="clr-namespace:ORTools.UI.Helpers"
             Background="Transparent"
             AllowDrop="True"
             DragOver="ProfilesView_DragOver"
             Drop="ProfilesView_Drop">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- Profiles List -->
        <ListBox Grid.Row="0" Grid.Column="0" ItemsSource="{Binding ProfileList}" SelectedItem="{Binding SelectedProfile}"
                 Background="{DynamicResource AppInputBrush}" Foreground="{DynamicResource AppTextBrush}"
                 BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1"
                 HorizontalContentAlignment="Stretch" Margin="0,0,16,12">
            <ListBox.Resources>
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="Transparent" />
                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="Transparent" />
            </ListBox.Resources>
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Margin" Value="0"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <ContentPresenter />
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <EventSetter Event="MouseDoubleClick" Handler="ListBoxItem_MouseDoubleClick" />
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <!-- Subtle hover tint (theme-safe in light & dark) -->
                        <Border x:Name="HoverOverlay" Background="{DynamicResource AppTextBrush}" Opacity="0" IsHitTestVisible="False" />
                        <!-- Subtle selection tint (high contrast in all themes) -->
                        <Border x:Name="SelectedOverlay" Background="{DynamicResource AppPrimaryBrush}" Opacity="0" IsHitTestVisible="False" />

                        <Border x:Name="ItemBorder" BorderThickness="3,0,0,0" BorderBrush="Transparent" Padding="10,7" Background="Transparent">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse Width="7" Height="7" Fill="{DynamicResource AppSuccessBrush}"
                                                 VerticalAlignment="Center" Margin="0,0,7,0"
                                                 Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVis}}" />
                                        <TextBlock Text="{Binding Name}" FontSize="13" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
                                                    <Setter Property="FontStyle" Value="Normal" />
                                                    <Setter Property="FontWeight" Value="Normal" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Name}" Value="Default">
                                                            <Setter Property="FontStyle" Value="Italic" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0"
                                                Visibility="{Binding HasLinkedCharacters, Converter={StaticResource BoolToVis}}">
                                        <TextBlock FontFamily="pack://application:,,,/Fonts/#lucide" Text="&#xE19F;"
                                                   FontSize="11" Foreground="{DynamicResource AppSubtleBrush}"
                                                   VerticalAlignment="Center" Margin="0,0,5,0" />
                                        <TextBlock Text="{Binding LinkedCharactersSummary}"
                                                   FontSize="11.5" Foreground="{DynamicResource AppSubtleBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </StackPanel>

                                <Border Grid.Column="1" VerticalAlignment="Center" Padding="7,2" CornerRadius="4"
                                        Background="{DynamicResource AppSurfaceBrush}"
                                        BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1"
                                        Visibility="{Binding HasHotkey, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding Hotkey, Converter={StaticResource KeyToStringConverter}}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}" />
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                    <DataTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="HoverOverlay" Property="Opacity" Value="0.06" />
                        </Trigger>
                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type ListBoxItem}}, Path=IsSelected}" Value="True">
                            <Setter TargetName="SelectedOverlay" Property="Opacity" Value="0.16" />
                            <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource AppPrimaryBrush}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                            <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource AppSuccessBrush}" />
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Action Buttons Panel -->
        <StackPanel Grid.Row="0" Grid.Column="1" Width="140">
            <Button Content="{DynamicResource S.Profiles.Create}" Command="{Binding SaveProfileCommand}" Height="28" Margin="0,0,0,8"
                    Style="{StaticResource SecondaryButtonStyle}" />
            <Button Content="{DynamicResource S.Profiles.Rename}" Command="{Binding RenameProfileCommand}" Height="28" Margin="0,0,0,8"
                    Style="{StaticResource SecondaryButtonStyle}" />
            <Button Content="{DynamicResource S.Profiles.Copy}" Command="{Binding CopyProfileCommand}" Height="28" Margin="0,0,0,8"
                    Style="{StaticResource SecondaryButtonStyle}" />
            <Button Content="{DynamicResource S.Profiles.Import}" Command="{Binding ImportProfileCommand}" Height="28" Margin="0,0,0,8"
                    Style="{StaticResource SecondaryButtonStyle}" />
            <Button Content="{DynamicResource S.Profiles.Export}" Command="{Binding ExportProfileCommand}" Height="28" Margin="0,0,0,8"
                    Style="{StaticResource SecondaryButtonStyle}" />
            <Button Content="{DynamicResource S.Profiles.Delete}" Command="{Binding RemoveProfileCommand}" Height="28" Margin="0,0,0,0"
                    Style="{StaticResource DangerButtonStyle}" />
        </StackPanel>

        <!-- Selected Profile Details Card -->
        <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                Background="{DynamicResource AppSurfaceBrush}"
                BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1"
                CornerRadius="6" Padding="14,12"
                Visibility="{Binding HasSelectedProfile, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <!-- Card Header -->
                <Grid Margin="0,0,0,8">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock FontFamily="pack://application:,,,/Fonts/#lucide" Text="&#xE154;"
                                   FontSize="15" Foreground="{DynamicResource AppLinkBrush}"
                                   VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="{Binding SelectedProfile.Name}" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AppTextBrush}" VerticalAlignment="Center" />
                    </StackPanel>

                    <CheckBox HorizontalAlignment="Right" Content="{DynamicResource S.Profiles.AutoSwitchChar}"
                              IsChecked="{Binding AutoSwitchProfileByChar}"
                              Foreground="{DynamicResource AppTextBrush}" FontSize="12.5" VerticalAlignment="Center" />
                </Grid>

                <Border Height="1" Background="{DynamicResource AppBorderBrush}" Opacity="0.4" Margin="0,0,0,10" />

                <!-- Row 1: Switch Hotkey -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="155" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock FontFamily="pack://application:,,,/Fonts/#lucide" Text="&#xE2B4;"
                                   FontSize="14" Foreground="{DynamicResource AppSubtleBrush}"
                                   VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="{DynamicResource S.Profiles.SwitchHotkey}"
                                   Foreground="{DynamicResource AppTextBrush}" FontSize="13" VerticalAlignment="Center" />
                    </StackPanel>

                    <TextBox Grid.Column="1" Text="{Binding SelectedProfile.Hotkey, Mode=OneWay, Converter={StaticResource KeyToStringConverter}}"
                             PreviewKeyDown="ProfileHotkeyTextBox_PreviewKeyDown"
                             Width="110" Height="28" FontSize="12"
                             ToolTip="{DynamicResource S.Profiles.HotkeyHint}">
                        <TextBox.Style>
                            <Style TargetType="TextBox" BasedOn="{StaticResource KeyTextBoxStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedProfile.HasHotkey}" Value="True">
                                        <Setter Property="BorderBrush" Value="{DynamicResource AppToggleOnBrush}" />
                                        <Setter Property="BorderThickness" Value="1.5" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>

                    <TextBlock Grid.Column="2" Text="{DynamicResource S.Profiles.HotkeyHint}"
                               Foreground="{DynamicResource AppSubtleBrush}" FontSize="11.5"
                               VerticalAlignment="Center" Margin="10,0,0,0" TextTrimming="CharacterEllipsis" />
                </Grid>

                <!-- Row 2: Linked Characters -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="155" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock FontFamily="pack://application:,,,/Fonts/#lucide" Text="&#xE19F;"
                                   FontSize="14" Foreground="{DynamicResource AppSubtleBrush}"
                                   VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="{DynamicResource S.Profiles.LinkedChars}"
                                   Foreground="{DynamicResource AppTextBrush}" FontSize="13" VerticalAlignment="Center" />
                    </StackPanel>

                    <ItemsControl Grid.Column="1" ItemsSource="{Binding SelectedProfile.LinkedCharacters}" VerticalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource AppInputBrush}" BorderBrush="{DynamicResource AppBorderBrush}"
                                        BorderThickness="1" CornerRadius="12" Padding="10,3,6,3" Margin="0,2,6,2">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding}" FontSize="12" Foreground="{DynamicResource AppTextBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <Button Content="✕" FontSize="10" Padding="2,0" Background="Transparent" BorderThickness="0"
                                                Foreground="{DynamicResource AppSubtleBrush}" Cursor="Hand"
                                                Command="{Binding DataContext.UnlinkCharacterCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Button Grid.Column="2"
                            Command="{Binding LinkCharacterCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Height="28" Padding="12,0" FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock FontFamily="pack://application:,,,/Fonts/#lucide" Text="&#xE19F;" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="{DynamicResource S.Profiles.LinkChar}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
